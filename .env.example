# ===== UNIQUE BASKET – CLOUD SETTINGS (keep private, never upload to GitHub) =====

# 1) Paste your MongoDB Atlas connection string (Atlas > Connect > Drivers).
#    Replace USER and PASSWORD. Use a password with letters+numbers only (no @ # / : ?).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 2) Database name (created automatically)
MONGO_DB=uniquebasket

# 3) Manager password. Used ONCE, when the first PC starts and creates the manager login.
#    Login afterwards: username  manager   password  = this value
ADMIN_PASSWORD=Basket2026Shop

# Only used if you run the hosted backend (Option B in SETUP.md)
PORT=4310
