# ===== SHOP SERVER (manager PC) settings — this file stays on the server PC only, never on counters =====
# Database. Recommended: MongoDB Community installed on the manager PC (billing works without internet):
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
# Or MongoDB Atlas (billing then needs internet):  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGO_DB=uniquebasket
# Manager password, used only on the very first start to create the "manager" login (8+ characters)
ADMIN_PASSWORD=
# Port the counters connect to
PORT=4310
# Shop time zone for business dates
SHOP_TZ=Asia/Kolkata
# Optional: where backups are written (default: <data>/backups). Point to a second disk / synced folder.
BACKUP_DIR=
# Development only — creates demo operators/products. NEVER set on a real shop.
SEED_DEMO=0
