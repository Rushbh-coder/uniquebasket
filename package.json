{
  "name": "wholesale-billing-desktop",
  "version": "3.0.0",
  "main": "main.js",
  "description": "Multi-counter Fruit & Vegetable Wholesale/Retail Billing (POS, weighing, inventory, ledger)",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "server": "npm run build && node server/index.js",
    "web": "npm run server",
    "test": "node --test --test-concurrency=1 tests/",
    "test:offline": "set TEST_DB=nedb&& node --test --test-concurrency=1 tests/api.test.js",
    "dist": "npm run build && node make-config.js && electron-builder --win",
    "cloud": "node cloud.js",
    "test-mongo": "node test-mongo.js",
    "seed-demo": "set SEED_DEMO=1&& node server/index.js"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.0.4",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.shop.billing",
    "productName": "Wholesale Billing",
    "files": [
      "main.js",
      "preload.js",
      "bill-pdf.js",
      "setup.html",
      "server/**",
      "client/dist/**",
      "package.json",
      "!**/tests/**",
      "!**/*.test.js"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "directories": {
      "output": "release"
    },
    "asar": true
  },
  "author": "Unique Basket"
}